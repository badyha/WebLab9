@page
@model CreatePizzaModel
@{
    ViewData["Title"] = "Create Pizza";
}

<div class="container">
    <h1>➕ Додати нову піцу</h1>

    <form method="post" class="form-container">
        <div class="form-group">
            <label for="name">Назва піци:</label>
            <input type="text" id="name" name="Pizza.Name" placeholder="Наприклад: Маргарита" required />
        </div>

        <div class="form-group">
            <label for="size">Розмір:</label>
            <select id="size" name="Pizza.Size" required>
                <option value="">Виберіть розмір</option>
                <option value="Маленька">Маленька (25 см)</option>
                <option value="Середня">Середня (30 см)</option>
                <option value="Велика">Велика (35 см)</option>
            </select>
        </div>

        <div class="form-group">
            <label for="price">Ціна (₴):</label>
            <input type="number" id="price" name="Pizza.Price" step="0.01" placeholder="Наприклад: 150" required />
        </div>

        <div class="form-group">
            <label for="quantity">Кількість:</label>
            <input type="number" id="quantity" name="Pizza.Quantity" placeholder="Наприклад: 10" required />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-success">✓ Зберегти</button>
            <a class="btn btn-secondary" asp-page="PizzaList">← Скасувати</a>
        </div>
    </form>
</div>

<style>
    .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 30px;
    }

    h1 {
        color: #d4a574;
        text-align: center;
        margin-bottom: 30px;
    }

    .form-container {
        background-color: white;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        display: block;
        margin-bottom: 8px;
        font-weight: bold;
        color: #333;
    }

    input, select {
        width: 100%;
        padding: 10px;
        border: 2px solid #ddd;
        border-radius: 4px;
        font-size: 1em;
        box-sizing: border-box;
    }

    input:focus, select:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 5px rgba(102, 126, 234, 0.3);
    }

    .form-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 30px;
    }

    .btn {
        padding: 12px 30px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-size: 1em;
        text-decoration: none;
        transition: all 0.3s;
    }

    .btn-success {
        background-color: #4a7c59;
        color: white;
    }

    .btn-success:hover {
        background-color: #2d5016;
    }

    .btn-secondary {
        background-color: #999;
        color: white;
    }

    .btn-secondary:hover {
        background-color: #777;
    }
</style>
